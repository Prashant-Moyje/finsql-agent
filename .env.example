# --- LLM: "ollama" (local, free) or "groq" (hosted free tier) ---
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Warehouse: "duckdb" (local demo) or "snowflake" ---
WAREHOUSE=duckdb
# SNOWFLAKE_ACCOUNT=xy12345.us-east-1
# SNOWFLAKE_USER=FINSQL_SVC
# SNOWFLAKE_PRIVATE_KEY_PATH=./keys/finsql_rsa_key.p8
# SNOWFLAKE_ROLE=AI_READER
# SNOWFLAKE_WAREHOUSE=AI_WH
# SNOWFLAKE_DATABASE=FINANCE
# SNOWFLAKE_SCHEMA=REPORTING

# --- Context store: local path or s3://bucket/key ---
# CATALOG_PATH=context_store/catalog.json

# --- Slack (optional locally) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
# Comma-separated IDs; empty = everyone
ALLOWED_SLACK_USERS=
ALLOWED_SLACK_CHANNELS=
